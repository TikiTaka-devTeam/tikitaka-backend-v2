# Copy this file to .env and replace the placeholder password. Never commit .env.
DB_NAME=tikitaka
DB_URL=jdbc:postgresql://localhost:5433/tikitaka
DB_USERNAME=tikitaka
DB_PASSWORD=change-me
DB_PORT=5433

# LocalStack S3 values for the local profile. These are local-only dummy credentials.
AWS_S3_BUCKET=tikitaka-local
AWS_REGION=ap-northeast-2
AWS_S3_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566

# PowerShell: docker compose --env-file .env up -d
# PowerShell: $env:SPRING_PROFILES_ACTIVE="local"; .\gradlew.bat bootRun
# Tests require a running Docker daemon: .\gradlew.bat test
