SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
PHONE_VERIFICATION_PEPPER=
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# 인증번호 해시에 사용하는 서버 전용 비밀값입니다. 환경별 강한 난수값을 별도로 설정하세요.

# 이 파일을 .env로 복사한 뒤 예시 비밀번호를 실제 로컬 값으로 변경하세요. .env는 절대 커밋하지 마세요.
DB_NAME=tikitaka
DB_URL=jdbc:postgresql://localhost:5433/tikitaka
DB_USERNAME=tikitaka
DB_PASSWORD=change-me
DB_PORT=5433

# local 프로필에서 사용하는 LocalStack S3 설정입니다. 로컬 전용 더미 인증정보입니다.
AWS_S3_BUCKET=tikitaka-local
AWS_REGION=ap-northeast-2
AWS_S3_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566

# PowerShell: docker compose --env-file .env up -d
# PowerShell: $env:SPRING_PROFILES_ACTIVE="local"; .\gradlew.bat bootRun
# 테스트를 실행하려면 Docker 데몬이 실행 중이어야 합니다: .\gradlew.bat test
